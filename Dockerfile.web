# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# The Go site (cmd/web) for Cloud Run: one static binary on distroless, so a
# cold instance starts in well under a second. It replaces Dockerfile (Qwik)
# at the Phase 8 cutover (plans/go-datastar-scale-to-zero.md).
#
#   docker build -f Dockerfile.web -t aestheticlab-web:local .

FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm@sha256:21ade014faf952365b9ecbd8dbdb87176fbacb82fac9fb132d9f2a7b8cc3f132 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal
COPY static ./static
# No `go mod download`: go.mod also lists the lint and security tools, and the
# build fetches only the modules cmd/web imports.
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
	CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags "-s -w" \
	-o /out/web ./cmd/web

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/web /web
LABEL org.opencontainers.image.title="Aesthetic Lab" \
	org.opencontainers.image.source="https://github.com/lieranderl/qwik-aestheticlab"
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/web"]
