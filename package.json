{
	"name": "aestheticlab",
	"description": "AestheticLab",
	"version": "5.0.2",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "^20.3.0 || >=21.0.0"
	},
	"engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
	"private": true,
	"trustedDependencies": [
		"sharp"
	],
	"trustedDependencies-annotation": "Needed for bun to allow running install scripts",
	"type": "module",
	"scripts": {
		"assets": "bun run icons && bun frontend/build.mjs",
		"icons": "bun frontend/icons.mjs",
		"test.frontend": "bun test frontend scripts",
		"test.e2e": "playwright test",
		"share-images": "bun scripts/share-images.ts",
		"biome": "biome check --fix",
		"precommit": "lint-staged --concurrent false",
		"prepush": "make ci",
		"docker.build": "docker buildx build --load --tag aestheticlab:local .",
		"docker.build.ci": "docker buildx build --platform linux/amd64 --load --tag aestheticlab:ci .",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@fontsource-variable/onest": "^5.3.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/cli": "4.3.3",
		"daisyui": "^5.7.50",
		"heroicons": "2.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"sharp": "0.35.5",
		"simple-icons": "16.35.0",
		"tailwindcss": "^4.3.3"
	},
	"overrides": {
		"sharp": "0.35.5"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,md,yml,yaml}": [
			"biome check --fix --no-errors-on-unmatched"
		]
	}
}
