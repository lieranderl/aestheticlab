package views

import (
	"net/url"

	"github.com/lieranderl/aestheticlab/internal/content"
)

// servicesSection is the home page's Treatments section. Its body switches
// between the overview, a category and the laser areas in place: Datastar
// fetches the body for the new URL (ServicesBody) and patches it in.
templ servicesSection(loc *content.Localized, query url.Values) {
	{{ t := selectTreatments(loc, query) }}
	@sectionWrapper("services", "bg-base-200", "Aesthetic Lab") {
		<div data-on:popstate__window="@get(location.pathname + location.search)" class="mb-6 grid gap-6 md:mb-14 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-end lg:gap-16">
			<div class="flex items-end justify-between gap-4">
				@FadeUp(0, false, "") {
					@Kicker("", "") {
						{ tr(ctx, "Treatments") }
					}
					<h2 class="text-balance font-cormorant text-[2.875rem] leading-[0.95] text-base-content md:text-7xl lg:text-[5.5rem] lg:leading-[0.9]">{ tr(ctx, "Our services") }</h2>
				}
				<a href="pricelist/" data-on:click={ pricingClicked("services_cta") } class="link inline-flex min-h-11 shrink-0 items-center font-main text-sm font-semibold underline-offset-[5px] lg:hidden">
					{ tr(ctx, "All prices") }
				</a>
			</div>
			<div class="hidden flex-col gap-4.5 lg:flex">
				if p := t.lowestAddOn(ctx); p != "" {
					<p class="font-cormorant text-[1.375rem] leading-snug text-base-content italic">
						{ trf(ctx, "Prices are for the treatment itself. Repairs, nail art and removal are add-ons from %v.", p) }
					</p>
				}
				<a href="pricelist/" data-on:click={ pricingClicked("services_cta") } class="link inline-flex min-h-11 items-center self-start font-main text-sm font-semibold underline-offset-[6px]">
					{ tr(ctx, "View full price list") }
				</a>
			</div>
		</div>
		@ServicesBody(t, loc.Contact.Location.Name, false)
		<div class="mt-5 md:mt-14 md:flex md:items-center md:justify-between md:gap-8 md:bg-primary md:px-9 md:py-7 md:text-primary-content">
			<p class="font-cormorant text-[1.1875rem] leading-snug text-base-content italic md:text-3xl md:text-primary-content">
				{ tr(ctx, "Not sure which to choose?") }
				<span class="hidden md:inline">{ tr(ctx, "We’ll help, free of charge.") }</span>
				<a href={ templ.SafeURL(instagramMessage) } target="_blank" rel="noopener noreferrer" data-on:click={ consultationClicked() } class="link font-main text-[0.8125rem] font-semibold not-italic underline-offset-4 md:hidden">
					{ tr(ctx, "Ask us") }
				</a>
			</p>
			<a href={ templ.SafeURL(instagramMessage) } target="_blank" rel="noopener noreferrer" data-on:click={ consultationClicked() } class="btn btn-outline hidden h-13 min-h-13 shrink-0 border-primary-content px-7 font-main text-sm font-semibold text-primary-content hover:bg-primary-content hover:text-primary md:inline-flex">
				{ tr(ctx, "Ask for a consultation") }
			</a>
		</div>
	}
}

// ServicesFragment is the services body for a Datastar request: the state
// the URL's query selects, bringing itself into view.
templ ServicesFragment(loc *content.Localized, query url.Values) {
	@ServicesBody(selectTreatments(loc, query), loc.Contact.Location.Name, true)
}

// ServicesBody is the switching part of the services section. With
// fragment (a Datastar request after a tap), it also brings itself into
// view: the treatments, or the section top for the overview.
templ ServicesBody(t treatments, location string, fragment bool) {
	<div
		id="services-body"
		if fragment {
			data-init={ revealTreatments(t) }
		}
	>
		if t.Category != "" {
			@treatmentDetail(t, location)
		} else if len(t.Display) == 0 {
			<div class="alert border border-base-300 bg-base-100" role="status">
				<span>{ tr(ctx, "No treatments listed yet.") }</span>
			</div>
		} else {
			@categoryTiles(t, t.Display, "category", "overview")
		}
	</div>
}

// categoryTiles are the category cards: chips to jump on phones, photo
// cards that swipe sideways on phones and form a grid from md up.
templ categoryTiles(t treatments, cats []content.Category, idPrefix, columns string) {
	<!-- Phones: every category one tap away, not several swipes. -->
	<ul class="mb-5 flex flex-wrap gap-2 md:hidden" aria-label={ tr(ctx, "Jump to a treatment") }>
		for _, c := range cats {
			<li>
				<button type="button" data-on:click={ tileOpen(ctx, t, c, columns) } class="btn btn-outline h-11 min-h-11 border-ink px-4 font-main text-sm font-medium text-ink hover:bg-ink hover:text-linen">
					{ tileTitle(ctx, c) }
				</button>
			</li>
		}
	</ul>
	<ul class={ "-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3.5 overflow-x-auto overscroll-x-contain px-4 pb-2 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:grid md:gap-6 md:overflow-visible md:px-0 md:pb-0",
		templ.KV("md:grid-cols-3 xl:grid-cols-5", columns == "overview"),
		templ.KV("md:grid-cols-2 lg:grid-cols-4", columns != "overview") }>
		for i, c := range cats {
			{{ descriptionID := idPrefix + "-" + c.ID + "-description" }}
			<li class="w-[72vw] max-w-72 shrink-0 snap-start md:w-auto md:max-w-none">
				<button
					type="button"
					data-on:click={ tileOpen(ctx, t, c, columns) }
					aria-describedby={ descriptionID }
					class="group flex h-full w-full flex-col gap-3.5 cursor-pointer text-left transition-[translate] duration-700 ease-(--ease-quint) hover:-translate-y-1.5 motion-reduce:transition-none"
				>
					<span class="relative block aspect-4/5 overflow-hidden bg-stone">
						@Picture(coverImage(categoryImageName(c)), "", "absolute inset-x-0 -top-3 h-[calc(100%+1.5rem)] w-full object-cover transition-transform duration-700 ease-(--ease-quint) group-hover:-translate-y-3 motion-reduce:transition-none", "(min-width: 1280px) 15rem, (min-width: 768px) 30vw, 72vw", true)
						if from := fromPrice(ctx, c.Services); from != "" {
							<span class="absolute top-3.5 left-3.5 bg-blush px-3 py-1.5 font-main text-[0.8125rem] font-semibold text-ink">{ from }</span>
						}
					</span>
					<span class="flex items-baseline justify-between gap-4 border-b border-ink pb-3">
						<span class="font-cormorant text-[2rem] leading-none text-ink md:text-[2.125rem]">{ tileTitle(ctx, c) }</span>
						<span class="font-main text-xs font-semibold tracking-[0.12em] text-rosewood">{ twoDigits(i + 1) }</span>
					</span>
					<span class="flex items-center justify-between gap-3 font-main text-sm font-medium text-sage-700">
						{ treatmentCount(ctx, c.Services) }
						<span class="text-ink transition-transform duration-500 ease-(--ease-quint) group-hover:translate-x-1.5">
							@arrow("size-4.5")
						</span>
					</span>
					<span id={ descriptionID } class="hidden font-main text-[0.9375rem] leading-relaxed text-sage-700 md:line-clamp-4">{ categoryDescription(ctx, c.Group) }</span>
				</button>
			</li>
		}
	</ul>
}

// treatmentDetail is a selected category: its summary, the sticky back
// buttons and category chips, then its treatments (or the laser areas).
templ treatmentDetail(t treatments, location string) {
	<div class="space-y-8 md:space-y-10">
		if d, ok := t.detail(); ok {
			<section id="service-details-card" data-testid="service-details-card" aria-labelledby="service-details-heading" class="scroll-mt-24 border-t border-neutral pt-6 md:pt-8">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-10">
					<div>
						<p class="font-main text-sm font-semibold text-base-content/80">{ detailSummary(ctx, d) }</p>
						<h3 id="service-details-heading" tabindex="-1" class="mt-2 text-balance font-cormorant text-[2.5rem] leading-none text-base-content md:text-6xl">{ detailTitle(ctx, d) }</h3>
					</div>
					<p class="max-w-md text-pretty font-main text-[0.9375rem] leading-relaxed text-base-content/80">{ categoryDescription(ctx, d.Group) }</p>
				</div>
			</section>
		}
		<!-- Back buttons and category chips stay under the header while the treatments scroll past. -->
		<div class="sticky top-[calc(4rem+env(safe-area-inset-top))] z-20 -mx-4 flex items-center gap-2 border-b border-base-300 bg-base-200/95 px-4 py-2.5 backdrop-blur-sm sm:-mx-6 sm:px-6 md:mx-0 md:gap-5 md:px-0">
			<div data-testid="service-back-actions" class="flex shrink-0 items-center gap-1 border-r border-base-300 pr-2 md:gap-5 md:pr-5">
				<button type="button" data-on:click={ backToOverview } aria-label={ trc(ctx, "treatment overview", "Back to categories") } class={ backButton }>
					<span aria-hidden="true">←</span>
					<span class="hidden md:inline">{ trc(ctx, "treatment overview", "Back to categories") }</span>
				</button>
				if t.Area != "" {
					<button type="button" data-on:click={ backToLaser } aria-label={ tr(ctx, "Back to laser category") } class={ backButton }>
						<span aria-hidden="true">←</span>
						<span class="md:hidden">{ tr(ctx, "Laser") }</span>
						<span class="hidden md:inline">{ tr(ctx, "Back to laser category") }</span>
					</button>
				}
			</div>
			<nav id="service-category-nav" class="min-w-0 flex-1 overflow-x-auto overscroll-x-contain [scrollbar-width:none]" aria-label={ tr(ctx, "Services") }>
				<div class="flex w-max gap-2">
					for _, c := range t.Display {
						<button
							type="button"
							data-on:click={ openTreatment(ctx, c.ID, "", c, "services_overview") }
							class={ "btn btn-sm h-11 min-h-11 shrink-0 border-neutral px-4 font-main text-sm font-semibold whitespace-nowrap", templ.KV("btn-neutral", c.ID == t.Category), templ.KV("btn-outline", c.ID != t.Category) }
							aria-pressed={ boolString(c.ID == t.Category) }
						>
							{ tileTitle(ctx, c) }
						</button>
					}
				</div>
			</nav>
		</div>
		if t.choosingArea() {
			@categoryTiles(t, t.Laser, "laser", "laser")
		} else if d, ok := t.detail(); ok {
			<ul class="max-w-4xl border-t border-base-300">
				for _, s := range ordered(d.Services) {
					@serviceRow(s, t.serviceCategory(ctx, s, d), location)
				}
			</ul>
		}
	</div>
}

// serviceRow is a treatment with its price, description and Book button.
templ serviceRow(s content.Service, category, location string) {
	<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 gap-y-3 border-b border-base-300 py-5 md:grid-cols-[minmax(0,1fr)_auto_auto] md:items-start">
		<div class="min-w-0">
			<h4 class="font-cormorant text-2xl leading-tight text-base-content md:text-[1.75rem]">{ upperFirst(s.Name) }</h4>
			if s.Duration > 0 {
				<p class="mt-1 font-main text-sm font-semibold text-base-content/80">{ minutesNoBreak(ctx, s.Duration) }</p>
			}
		</div>
		<p class="font-cormorant text-2xl leading-tight text-base-content md:col-start-2 md:row-start-1 md:min-w-20 md:text-right md:text-[1.75rem]">{ price(ctx, s.Price) }</p>
		if s.Description != "" {
			<div class="col-span-2 md:col-span-1 md:col-start-1 md:row-start-2">
				@expandableText(s.Description)
			</div>
		}
		<div class="col-span-2 md:col-span-1 md:col-start-3 md:row-span-2 md:row-start-1">
			@BookButton(Booking{ID: "modal_service_" + s.ID, Product: s.ID, Text: tr(ctx, "Book now"), Location: location,
				Placement: "service_row", ServiceID: s.ID, ServiceName: s.Name, ServiceCategory: category,
				Class: "btn btn-outline btn-secondary btn-sm h-11 min-h-11 px-5 font-main text-sm font-semibold"})
		</div>
	</li>
}

// expandableText clamps a long text to three lines, with Read more.
templ expandableText(text string) {
	<div>
		<p class="text-pretty font-main text-sm leading-relaxed text-base-content/80 line-clamp-3">{ text }</p>
		if len([]rune(text)) > 140 {
			<button
				type="button"
				aria-expanded="false"
				data-on:click={ readMore(ctx) }
				class="link link-hover inline-flex min-h-11 w-fit items-center font-main text-[0.6875rem] font-semibold uppercase tracking-[0.16em] underline-offset-4"
			>
				{ tr(ctx, "Read more") }
			</button>
		}
	</div>
}

templ arrow(class string) {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={ class } aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
}

const backButton = "btn btn-ghost h-11 min-h-11 shrink-0 gap-2 border-0 px-2.5 font-main text-sm font-semibold hover:bg-base-200 md:px-0 md:hover:bg-transparent md:hover:underline md:underline-offset-[6px]"
