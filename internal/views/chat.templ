package views

// chatWidget is the assistant's launcher and panel, bottom right, with the
// back-to-top arrow above it (ScrollToTop). The transcript lives in
// #chat-log; the server appends each message to it over SSE. Everything
// starts hidden and Datastar reveals it: without JavaScript the chat cannot
// send, so it must not cover the page.
templ chatWidget() {
	<!-- The conversation is kept for this tab (aesthetic.chatRestore, chatSave in site.js). -->
	<div
		id="chat"
		hidden
		data-signals={ chatSignals }
		data-attr:hidden="false"
		data-init="$chatHistory = aesthetic.chatRestore(); $chatOpen = aesthetic.chatWasOpen()"
		data-effect="aesthetic.chatSave($chatHistory, $chatOpen)"
		class="fixed right-4 bottom-[calc(env(safe-area-inset-bottom)+5.5rem)] z-40 lg:right-6 lg:bottom-6"
	>
		<!-- daisyUI's aura in the studio's colours (aura-brand in app.css): a
		slowly turning ring that marks the AI assistant; the negative margin keeps
		the button where it was. Still with reduced motion (the glow layers
		inherit the animation). -->
		<div
			id="chat-aura"
			class="aura aura-brand -m-0.5 rounded-full [--aura-radius:9999px] motion-reduce:animate-none"
			data-attr:hidden="$chatOpen"
		>
			<button
				id="chat-open"
				type="button"
				class="btn btn-circle btn-accent size-14 shadow-lg"
				aria-label={ tr(ctx, "Chat with our assistant") }
				title={ tr(ctx, "Chat with our assistant") }
				aria-controls="chat-panel"
				data-attr:aria-expanded="$chatOpen ? 'true' : 'false'"
				data-attr:hidden="$chatOpen"
				data-on:click="$chatOpen = true; setTimeout(() => document.getElementById('chat-input')?.focus(), 0)"
			>
				@Icon("outline/chat-bubble-left-right", "size-6")
			</button>
		</div>
		<section
			id="chat-panel"
			role="dialog"
			aria-labelledby="chat-title"
			class="card flex h-[min(36rem,calc(100dvh-8rem))] w-[min(24rem,calc(100vw-2rem))] flex-col lg:h-[min(44rem,calc(100dvh-7.5rem))] lg:w-md border border-base-300 bg-base-100 shadow-xl"
			hidden
			data-attr:hidden="!$chatOpen"
			data-on:keydown__window="evt.key === 'Escape' && $chatOpen && ($chatOpen = false)"
		>
			<header class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
				<h2 id="chat-title" class="font-cormorant text-2xl leading-none">{ tr(ctx, "Ask Aesthetic Lab") }</h2>
				<button id="chat-close" type="button" class="btn btn-circle btn-ghost btn-sm" aria-label={ tr(ctx, "Close chat") } data-on:click="$chatOpen = false">
					@Icon("mini/x-mark", "size-5")
				</button>
			</header>
			<p class="border-b border-base-300 bg-base-200 px-4 py-2 font-main text-xs text-base-content/80">
				{ tr(ctx, "AI assistant: it can make mistakes. Please don't share health details.") }
			</p>
			<!-- column-reverse keeps the newest message in view as the log grows. -->
			<div class="flex grow flex-col-reverse overflow-y-auto px-4 py-3">
				<div>
					<div id="chat-log" class="flex flex-col gap-3" aria-live="polite">
						@ChatMessage(false, tr(ctx, "Hi! Ask me about our treatments, prices, team or free times."), nil, nil, nil, 0)
					</div>
					<div class="chat chat-start" hidden data-attr:hidden="!$chatBusy">
						<div class="chat-bubble bg-base-200 font-main text-sm">
							<span class="skeleton skeleton-text bg-transparent">{ tr(ctx, "Thinking…") }</span>
						</div>
					</div>
				</div>
			</div>
			<!-- Common questions, one tap to ask, until the conversation starts. -->
			<div
				id="chat-suggestions"
				role="group"
				aria-label={ tr(ctx, "Suggested questions") }
				class="flex flex-wrap justify-end gap-2 px-3 pb-3"
				hidden
				data-attr:hidden="$chatHistory.length > 0 || $chatBusy"
			>
				for _, q := range chatSuggestions(ctx) {
					<button
						type="button"
						class="btn btn-outline btn-sm h-auto min-h-8 rounded-full border-base-300 py-1.5 font-main text-xs font-normal normal-case"
						data-on:click={ "$chatInput = " + jsString(q) + "; @post('" + href(ctx, "chat") + "')" }
					>{ q }</button>
				}
			</div>
			<form class="flex items-end gap-2 border-t border-base-300 p-3" data-on:submit={ "$chatInput.trim() && !$chatBusy && @post('" + href(ctx, "chat") + "')" }>
				<label for="chat-input" class="sr-only">{ tr(ctx, "Your question") }</label>
				<!-- Enter sends, Shift+Enter adds a line. Typed text stays 16px (phones
				zoom into smaller fields); only the hint is smaller. While empty the
				field holds two lines of hint: Safari sizes it to typed text only. -->
				<textarea
					id="chat-input"
					rows="2"
					maxlength="500"
					autocomplete="off"
					class="textarea textarea-bordered max-h-32 min-h-11 grow placeholder-shown:min-h-15 resize-none field-sizing-content font-main text-base leading-snug placeholder:text-sm"
					placeholder={ tr(ctx, "Ask about treatments, prices or free times") }
					data-bind:chat-input
					data-attr:disabled="$chatBusy"
					data-on:keydown="evt.key === 'Enter' && !evt.shiftKey && !evt.isComposing && (evt.preventDefault(), el.form.requestSubmit())"
				></textarea>
				<button id="chat-send" type="submit" class="btn btn-primary btn-square" aria-label={ tr(ctx, "Send") } data-attr:disabled="$chatBusy || !$chatInput.trim()">
					@Icon("mini/paper-airplane", "size-5")
				</button>
			</form>
		</section>
	</div>
}

// ChatMessage is one message in the chat log: the visitor's on the right,
// the assistant's on the left with the free times it found, its Book
// buttons and the treatments to choose from. n numbers the message so its
// buttons' ids stay unique.
templ ChatMessage(visitor bool, text string, times []ChatTimes, offers []ChatOffer, choices []ChatChoice, n int) {
	if visitor {
		<div class="chat chat-end">
			<div class="chat-bubble chat-bubble-primary whitespace-pre-line font-main text-sm">{ text }</div>
		</div>
	} else {
		<div class="chat chat-start">
			<!-- The times come from the lookup itself, never from the model's
			text (assistant.FreeTimes). No nested div: scripts/chat-test-set.ts
			reads the bubble up to its first closing div. -->
			<div class="chat-bubble bg-base-200 whitespace-pre-line font-main text-sm text-base-content">
				{ text }
				for i, t := range times {
					<p class={ "font-semibold", templ.KV("mt-2", text != "" || i > 0) }>{ chatTimesHeading(ctx, t) }</p>
                    if amount := chatTimesPrice(ctx, t); amount != "" {
                        <p class="mt-1">{ amount }</p>
                    }
                    if status := chatTimesStatus(ctx, t); status != "" {
                        <p class="mt-1">{ status }</p>
                    } else {
					<ul class="chat-times mt-1 tabular-nums" aria-label={ chatTimesHeading(ctx, t) }>
						for _, s := range t.Slots {
							<li><time datetime={ s.Start.Format("2006-01-02T15:04") }>{ chatSlotWhen(ctx, s) }</time>{ chatSlotStaff(t, s) }</li>
						}
					</ul>
                    }
					if u := chatUnchecked(ctx, t); u != "" {
						<p class="mt-1 text-xs text-base-content/80">{ u }</p>
					}
				}
				if chatHasSlots(times) {
					<p class="mt-2 text-xs text-base-content/80">{ chatTimesNote(ctx) }</p>
				}
			</div>
			if len(offers) > 0 {
				<div class="chat-footer mt-2 flex flex-col items-start gap-2 opacity-100">
					for _, o := range offers {
						@BookButton(chatBooking(ctx, o, n))
					}
				</div>
			}
			<!-- A choice of treatments: each button asks for that one's free
			times in the visitor's words and sends its ID, so the server looks
			up that treatment itself (assistant.Times). -->
			if len(choices) > 0 {
				<div class="chat-footer mt-2 flex flex-wrap items-start gap-2 opacity-100" role="group" aria-label={ tr(ctx, "Treatments to choose from") }>
					for _, c := range choices {
						<button
							type="button"
							class="btn btn-outline btn-sm h-auto min-h-8 rounded-full border-base-300 py-1.5 font-main text-xs font-normal normal-case"
							data-attr:disabled="$chatBusy"
							data-on:click={ "$chatInput = " + jsString(chatChoiceAsk(ctx, c)) + "; $chatService = " + jsString(c.ServiceID) + "; @post('" + href(ctx, "chat") + "')" }
						>{ c.Service }</button>
					}
				</div>
			}
		</div>
	}
}
